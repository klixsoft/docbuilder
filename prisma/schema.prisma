generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(USER)
  projectsLimit Int       @default(3)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  hash            String   @unique
  viewPassword    String?
  themes          String[] @default(["system", "light", "dark"])
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  schemas         Schema[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model Schema {
  id          String   @id @default(cuid())
  name        String   @default("Default Schema")
  hash        String   @unique @default(cuid())
  content     String?
  url         String?
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

